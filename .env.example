# Copy to .env and fill in for your own AWS account. Nothing here is a
# secret by itself -- actual credentials come from boto3's normal credential
# chain (a named profile, environment variables, or an execution role when
# deployed), never from this file. See README.md's "Running it" section.

# --- AWS ---

# A named profile in ~/.aws/credentials, or leave unset to use the default
# credential chain (ambient environment variables, or the execution role
# when running inside AgentCore).
AWS_PROFILE=your-profile-name

# Bedrock model access is per-region. Confirm the Anthropic models are
# enabled for this exact region before running anything live.
AWS_REGION=us-east-1

# --- Models ---

# Both default to Haiku (see smishsentinel/config.py) since Sonnet requires
# a one-time account-level "Anthropic use case details" attestation in the
# Bedrock console that not every account has completed yet. Override with a
# Sonnet inference-profile ID once that's done on your account, e.g.:
#   SMISH_REASONING_MODEL=us.anthropic.claude-sonnet-4-6
# SMISH_TRIAGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# SMISH_REASONING_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Storage ---

# Where smishsentinel/store.py persists case records. Defaults to a
# smishsentinel_data/ directory under the system temp directory if unset --
# see README.md's "Known limitations" for why this isn't durable storage.
# SMISH_STORE_DIR=/tmp/smishsentinel_data
