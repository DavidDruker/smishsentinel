# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environment
.venv/
venv/

# Secrets & credentials — never commit
.env
*.csv
credentials*
*_accessKeys*
.aws/

# AgentCore build artifacts — regenerated by `agentcore configure`, account/region-specific
.bedrock_agentcore/
.bedrock_agentcore.yaml
Dockerfile.bedrock_agentcore
.dockerignore

# WSL-native venv (separate from the Windows .venv/, both ignored above)
.venv-wsl/

# Local run output
runs/
*.log

# Persisted case records (smishsentinel/store.py) — local demo data, not
# something to publish, and can contain message text passed through it.
.smishsentinel_data/

# Scratch research notes — not part of the submission
research_dump/

# Unrelated tool debris that has occasionally landed in this directory
tmp/

# Ad-hoc debugging scripts/output, never meant to be committed
scratch_*
